# ─── Zerodha Kite (enctoken login) ───────────────────────────
# No Kite Connect app or API key needed — the pipeline logs in the
# same way the Kite web frontend does.
KITE_USER_ID=AB1234
KITE_PASSWORD=your_zerodha_password
KITE_TOTP_SECRET=your_base32_totp_secret

# ─── Google Gemini API ───────────────────────────────────────
# Up to three keys; each model in the fallback chain is retried
# against every key that is set. Only KEY1 is required.
GEMINI_API_KEY1=your_gemini_api_key
GEMINI_API_KEY2=
GEMINI_API_KEY3=

# ─── Gmail SMTP ──────────────────────────────────────────────
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password
RECIPIENT_EMAIL=recipient@example.com
